flowchart TD
    A([Start]) --> B[Open Java dashboard]
    B --> C[Request connection]
    C --> D{Connected?}
    D -- No --> E[Display connection error]
    E --> C
    D -- Yes --> F[Select command or mission action]
    F --> G{Input valid?}
    G -- No --> H[Show validation message]
    H --> F
    G -- Yes --> I[Send request through adapter]
    I --> J{Response received?}
    J -- No --> K[Log timeout / connection error]
    K --> L[Update interface status]
    J -- Yes --> M[Validate and parse response]
    M --> N[Update robot state and mission log]
    N --> L
    L --> O{Continue?}
    O -- Yes --> F
    O -- No --> P([End])
